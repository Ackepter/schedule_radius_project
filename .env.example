# Скопируйте в .env и задайте свои значения. .env в git не попадает.
POSTGRES_USER=children
POSTGRES_PASSWORD=children_password
POSTGRES_DB=children_center

# Пути внутри docker-compose (backend переписывается на хост postgres).
# Для локального запуска backend вне docker: postgresql+psycopg2://user:pass@localhost:5432/db
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER:-children}:${POSTGRES_PASSWORD:-children_password}@postgres:5432/${POSTGRES_DB:-children_center}

# Разрешенные origin для CORS (перечислите через запятую).
CORS_ORIGINS=http://localhost:8080,http://localhost

SEED_ON_STARTUP=false

# ── Авторизация (сессии) ──────────────────────────────────────────────────
SESSION_TTL_HOURS=24
# true только за HTTPS (в docker-nginx обычно нужно true, если терминируется TLS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Защита login от перебора ──────────────────────────────────────────────
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15